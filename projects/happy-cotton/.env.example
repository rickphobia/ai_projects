# The game reads no environment variables.
# These are the deploy scripts' settings (deploy/update-site.sh, deploy/rollback.sh), shown with
# their defaults. All are optional. The scripts don't read this file: export them in the shell.
HAPPY_COTTON_REPO_URL=https://github.com/rickphobia/ai_projects.git
HAPPY_COTTON_BRANCH=main
# The server's own checkout, only ever built from. Its parent folder also holds
# happy-cotton.deployed-commit and happy-cotton.lock.
HAPPY_COTTON_SRC_DIR=$HOME/homelab/dev/ai_projects
HAPPY_COTTON_SITE_ROOT=$HOME/homelab/html
HAPPY_COTTON_SITE_SUBPATH=ai-projects/happy-cotton
# 1 rebuilds even when main hasn't moved since the last deploy.
HAPPY_COTTON_FORCE=0
