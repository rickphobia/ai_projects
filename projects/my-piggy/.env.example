# The game reads no environment variables. These are the deploy scripts' settings
# (deploy/update-site.sh, deploy/rollback.sh), shown with their defaults. All optional.
# The scripts read them from the environment, not from this file.
MY_PIGGY_REPO_URL=https://github.com/rickphobia/ai_projects.git
MY_PIGGY_BRANCH=main
MY_PIGGY_SRC_DIR=$HOME/homelab/dev/ai_projects
MY_PIGGY_SITE_ROOT=$HOME/homelab/html
MY_PIGGY_SITE_SUBPATH=ai-projects/my-piggy
# 1 rebuilds even when main has not moved since the last deploy.
MY_PIGGY_FORCE=0
