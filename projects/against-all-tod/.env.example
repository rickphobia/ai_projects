# Where the site is served from. "./" works in any folder (the live site, PR previews, itch.io);
# an absolute path such as /ai-projects/against-all-tod/ must start and end with "/".
VITE_BASE_PATH=./
# "true" logs at debug level in the browser console; "false" logs info and above.
# ?debug=1 in the page URL turns debug logging on for one visit without a rebuild.
VITE_DEBUG=false
# Seed for a new Run when the URL gives none. Whole number from 0 to 4294967295.
VITE_DEFAULT_SEED=12345
# Optional. Names the build in the start-up log; the deploy script sets it to the commit.
# VITE_BUILD_VERSION=dev

# Server deploy scripts only (deploy/*.sh read these from the shell, not from .env; the game ignores them).
# Every one is optional; the values shown are the defaults.
# AGAINST_ALL_TOD_REPO_URL=https://github.com/rickphobia/ai_slops.git
# AGAINST_ALL_TOD_BRANCH=main
# AGAINST_ALL_TOD_SRC_DIR=$HOME/homelab/dev/ai_slops
# AGAINST_ALL_TOD_SITE_ROOT=$HOME/homelab/html
# AGAINST_ALL_TOD_SITE_SUBPATH=ai-projects/against-all-tod
# AGAINST_ALL_TOD_NODE_IMAGE=node:22.22.0-bookworm-slim
# AGAINST_ALL_TOD_FORCE=0
