# Where the site is served from. "./" works in any folder (the live site and PR previews);
# an absolute path such as /ai-projects/ascii-sky/ must start and end with "/".
VITE_BASE_PATH=./
# "true" logs at debug level in the browser console; "false" logs info and above.
# ?debug=1 in the page URL turns debug logging on for one visit without a rebuild.
VITE_DEBUG=false
# Optional. Names the build in the start-up log; the deploy script sets it to the commit.
# VITE_BUILD_VERSION=dev

# Server deploy scripts only (deploy/*.sh read these from the shell, not from .env; the game ignores them).
# Every one is optional; the values shown are the defaults.
# ASCII_SKY_REPO_URL=https://github.com/rickphobia/ai_projects.git
# ASCII_SKY_BRANCH=main
# ASCII_SKY_SRC_DIR=$HOME/homelab/dev/ai_projects
# ASCII_SKY_SITE_ROOT=$HOME/homelab/html
# ASCII_SKY_SITE_SUBPATH=ai-projects/ascii-sky
# ASCII_SKY_NODE_IMAGE=node:22.22.0-bookworm-slim
# ASCII_SKY_FORCE=0
