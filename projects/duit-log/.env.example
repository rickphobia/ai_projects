# Build-time values only. These are read by the build scripts and Gradle on the machine that
# builds the APK; nothing here is compiled into the app or read on the phone. The app itself has
# no environment variables: its settings live on the phone.
#
# Gradle does not read this file. Export the variables in your shell, or in CI as secrets.

# Where the Android SDK lives. Optional: defaults to ~/Android/Sdk.
ANDROID_HOME=/home/you/Android/Sdk

# Build number: the APK's versionCode. Optional: defaults to 1. CI sets it to the workflow's run
# number. (The version name is duitlog.versionName in gradle.properties.)
DUITLOG_BUILD_NUMBER=1

# Release signing, needed only for assembleRelease and assemblePreview (see the README's
# "Signing key" section). The build fails, naming what is missing, if any are unset.
# Keep the keystore outside the repo. CI gets the keystore as the base64 secret
# DUITLOG_KEYSTORE_BASE64 instead of a file path.
DUITLOG_KEYSTORE_FILE=/home/you/keys/duit-log-release.jks
DUITLOG_KEYSTORE_PASSWORD=
DUITLOG_KEY_ALIAS=duit-log
DUITLOG_KEY_PASSWORD=
