-- Databases made before ticket 06 have no captured Transactions and no "Couldn't read" list.
ALTER TABLE ledger_transaction ADD COLUMN wallet TEXT;
ALTER TABLE ledger_transaction ADD COLUMN posted_at INTEGER;
ALTER TABLE ledger_transaction ADD COLUMN original_text TEXT;
CREATE INDEX ledger_transaction_wallet_posted_at ON ledger_transaction(wallet, posted_at);

CREATE TABLE couldnt_read (
  id INTEGER NOT NULL PRIMARY KEY,
  wallet TEXT NOT NULL,
  posted_at INTEGER NOT NULL,
  original_text TEXT NOT NULL
);
