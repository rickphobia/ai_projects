[Unit]
Description=Build and publish Pawn Swarm from the latest main
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# %h is the home folder of the user running the unit. The path matches the default PAWN_SWARM_SRC_DIR.
ExecStart=%h/homelab/dev/ai_projects/projects/pawn-swarm/deploy/update-site.sh
# Add Environment=PAWN_SWARM_... lines here if you changed a default.
