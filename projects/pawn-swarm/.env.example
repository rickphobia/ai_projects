# Seed for a new run when none is given. Integer from 0 to 4294967295.
VITE_DEFAULT_SEED=12345

# Server deploy scripts only (deploy/*.sh read these from the shell, not from .env; the game ignores them).
# Every one is optional; the values shown are the defaults.
# PAWN_SWARM_REPO_URL=https://github.com/rickphobia/ai_projects.git
# PAWN_SWARM_BRANCH=main
# PAWN_SWARM_SRC_DIR=$HOME/homelab/dev/ai_projects
# PAWN_SWARM_SITE_ROOT=$HOME/homelab/html
# PAWN_SWARM_SITE_SUBPATH=ai-projects/pawn-swarm
# PAWN_SWARM_NODE_IMAGE=node:22.22.0-bookworm-slim
# PAWN_SWARM_FORCE=0
