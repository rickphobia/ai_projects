-- Version 3 (ticket 05) had no Notes: add the note table (Note.sq).
CREATE TABLE note (
  id INTEGER NOT NULL PRIMARY KEY,
  selection TEXT NOT NULL,
  text TEXT NOT NULL,
  written_at INTEGER NOT NULL,
  book TEXT,
  author TEXT,
  chapter TEXT,
  book_url TEXT,
  chapter_index INTEGER,
  position INTEGER,
  lookup_id INTEGER REFERENCES lookup(id)
);

CREATE INDEX note_lookup_id ON note(lookup_id);
