# Copy to .env and adjust. Every value shown is the default, except the two sign-in secrets
# below, which you must fill in.

# DEBUG, INFO, WARNING or ERROR.
RSS_NEWS_LOG_LEVEL=INFO
# Address and port the web server listens on. The Docker image sets the host to 0.0.0.0.
RSS_NEWS_HOST=127.0.0.1
RSS_NEWS_PORT=8000
# Public path prefix the host nginx serves the app under.
RSS_NEWS_ROOT_PATH=/ai-projects/rss-news
# The SQLite file; its folder is created if missing. The Docker image uses /app/data/rss-news.sqlite3.
RSS_NEWS_DATABASE_PATH=data/rss-news.sqlite3
# The built PWA (`npm run build` in pwa/). The Docker image uses /app/pwa.
RSS_NEWS_PWA_DIR=pwa/dist
# The owner's time zone, as an IANA name: "last 24 hours" and shown times use it.
RSS_NEWS_TIMEZONE=Asia/Kuala_Lumpur

# Sign-in. The password hash: run `uv run rss-news hash-password` and paste what it prints.
# Required; there is no default.
RSS_NEWS_PASSWORD_HASH=
# Signs the session cookie; at least 32 characters. Make one with `openssl rand -hex 32`.
# Required. Changing it, or the password, signs out every device.
RSS_NEWS_SESSION_SECRET=
# How long a sign-in lasts on a device, in days.
RSS_NEWS_SESSION_DAYS=60
# Send the cookie over https only. Set to false only for local runs over plain http.
RSS_NEWS_SECURE_COOKIES=true
# This many wrong passwords within the lockout time lock sign-in for that long.
RSS_NEWS_LOGIN_MAX_FAILURES=5
RSS_NEWS_LOGIN_LOCKOUT_MINUTES=15

# Fetching feeds. A Source is fetched again this many minutes after a successful fetch.
RSS_NEWS_FETCH_INTERVAL_MINUTES=15
# Reddit: seconds between the end of one request and the start of the next (Reddit allows
# about one every 6), and minutes before a subreddit is fetched again.
RSS_NEWS_REDDIT_GAP_SECONDS=10
RSS_NEWS_REDDIT_INTERVAL_MINUTES=60
# A failing Source's wait doubles after each failure in a row, up to this many hours. It is
# never disabled.
RSS_NEWS_FETCH_MAX_BACKOFF_HOURS=24
# How long one feed request may take before it counts as failed.
RSS_NEWS_FETCH_TIMEOUT_SECONDS=20
# Sent with every feed request, so site owners can see who is asking. Reddit refuses generic ones.
RSS_NEWS_USER_AGENT=rss-news/0.1 (+https://rickphobia.com/ai-projects/rss-news/)
