# Copy to .env and adjust. Every value shown is the default; none is a secret yet.

# DEBUG, INFO, WARNING or ERROR.
RSS_NEWS_LOG_LEVEL=INFO
# Address and port the web server listens on. The Docker image sets the host to 0.0.0.0.
RSS_NEWS_HOST=127.0.0.1
RSS_NEWS_PORT=8000
# Public path prefix the host nginx serves the app under.
RSS_NEWS_ROOT_PATH=/ai-projects/rss-news
# The SQLite file; its folder is created if missing. The Docker image uses /app/data/rss-news.sqlite3.
RSS_NEWS_DATABASE_PATH=data/rss-news.sqlite3
# The built PWA (`npm run build` in pwa/). The Docker image uses /app/pwa.
RSS_NEWS_PWA_DIR=pwa/dist
# The owner's time zone, as an IANA name: "last 24 hours" and shown times use it.
RSS_NEWS_TIMEZONE=Asia/Kuala_Lumpur
