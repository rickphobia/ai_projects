# Copy to .env and adjust. Every value shown is the default, except the two sign-in secrets
# below, which you must fill in.

# DEBUG, INFO, WARNING or ERROR.
RSS_NEWS_LOG_LEVEL=INFO
# Address and port the web server listens on. The Docker image sets the host to 0.0.0.0.
RSS_NEWS_HOST=127.0.0.1
RSS_NEWS_PORT=8000
# Public path prefix the host nginx serves the app under.
RSS_NEWS_ROOT_PATH=/ai-projects/rss-news
# The SQLite file; its folder is created if missing. The Docker image uses /app/data/rss-news.sqlite3.
RSS_NEWS_DATABASE_PATH=data/rss-news.sqlite3
# The built PWA (`npm run build` in pwa/). The Docker image uses /app/pwa.
RSS_NEWS_PWA_DIR=pwa/dist
# The owner's time zone, as an IANA name: "last 24 hours" and shown times use it.
RSS_NEWS_TIMEZONE=Asia/Kuala_Lumpur

# Sign-in. The password hash: run `uv run rss-news hash-password` and paste what it prints.
# Required; there is no default.
RSS_NEWS_PASSWORD_HASH=
# Signs the session cookie; at least 32 characters. Make one with `openssl rand -hex 32`.
# Required. Changing it, or the password, signs out every device.
RSS_NEWS_SESSION_SECRET=
# How long a sign-in lasts on a device, in days.
RSS_NEWS_SESSION_DAYS=60
# Send the cookie over https only. Set to false only for local runs over plain http.
RSS_NEWS_SECURE_COOKIES=true
# This many wrong passwords within the lockout time lock sign-in for that long.
RSS_NEWS_LOGIN_MAX_FAILURES=5
RSS_NEWS_LOGIN_LOCKOUT_MINUTES=15

# Fetching feeds. A Source is fetched again this many minutes after a successful fetch.
RSS_NEWS_FETCH_INTERVAL_MINUTES=15
# Reddit: seconds between the end of one request and the start of the next (Reddit allows
# about one every 6), and minutes before a subreddit is fetched again.
RSS_NEWS_REDDIT_GAP_SECONDS=10
RSS_NEWS_REDDIT_INTERVAL_MINUTES=60
# A failing Source's wait doubles after each failure in a row, up to this many hours. It is
# never disabled.
RSS_NEWS_FETCH_MAX_BACKOFF_HOURS=24
# How long one feed or Reader view page request may take before it counts as failed.
RSS_NEWS_FETCH_TIMEOUT_SECONDS=20
# Sent with every feed and Reader view request, so site owners can see who is asking. Reddit refuses generic ones.
RSS_NEWS_USER_AGENT=rss-news/0.1 (+https://rickphobia.com/ai-projects/rss-news/)

# Items that arrived more than this many days ago are deleted.
RSS_NEWS_ITEM_MAX_AGE_DAYS=90

# AI. The Anthropic API key, from https://console.anthropic.com/. Required; there is no default.
RSS_NEWS_ANTHROPIC_API_KEY=
# How long one AI request may take, and how many tries it gets (network errors, 429 and 5xx
# are tried again with growing waits).
RSS_NEWS_ANTHROPIC_TIMEOUT_SECONDS=120
RSS_NEWS_ANTHROPIC_MAX_ATTEMPTS=4
# The model that gives new Items their Importance and one-line summary. It needs a price below.
RSS_NEWS_SCORING_MODEL=claude-haiku-5-5
# Items per scoring call, and the most estimated prompt tokens one call may use. Haiku costs
# 5x more for prompts over 100K tokens, so keep the limit under that.
RSS_NEWS_SCORING_BATCH_SIZE=100
RSS_NEWS_SCORING_PROMPT_TOKEN_LIMIT=90000
# The model that writes Briefings, and how hard it thinks (low, medium or high). It needs a
# price below. Switch to claude-sonnet-5-5 if Briefings cost too much.
RSS_NEWS_BRIEFING_MODEL=claude-opus-5-5
RSS_NEWS_BRIEFING_EFFORT=low
# The most estimated prompt tokens one Briefing section (one Folder) may use: one-line summaries
# first, then the full text of the top Items, cut to fit.
RSS_NEWS_BRIEFING_TOKEN_BUDGET=40000
# 7 and 30 day Briefings only read Items with at least this Importance (1 to 5).
RSS_NEWS_BRIEFING_IMPORTANCE_CUTOFF=3
# The model that answers Chat questions, and how hard it thinks (low, medium or high). It needs
# a price below.
RSS_NEWS_CHAT_MODEL=claude-opus-5-5
RSS_NEWS_CHAT_EFFORT=low
# Once a Chat's prompt passes this many tokens, the API summarises its older turns.
RSS_NEWS_CHAT_COMPACTION_TOKENS=70000
# The model that defines selected words for the Dictionary. It needs a price below.
RSS_NEWS_DICTIONARY_MODEL=claude-haiku-5-5
# USD per million input/output tokens for each model, for the spending ledger.
RSS_NEWS_MODEL_PRICES=claude-haiku-5-5=0.10/0.50,claude-sonnet-5-5=2/10,claude-opus-5-5=4/20
# USD per web search (Chat searches the web only when asked or when no Items match), for the
# spending ledger.
RSS_NEWS_WEB_SEARCH_PRICE_USD=0.01
# Monthly AI budget in USD. The app warns at 80%; at 100% Briefings stop until next month
# (in RSS_NEWS_TIMEZONE), while scoring keeps running.
RSS_NEWS_MONTHLY_LIMIT_USD=100

# Alerts. Signs Web Push messages: run `uv run rss-news vapid-key` and paste the line it prints.
# Leave empty to run without Alerts. After changing it, each phone turns Alerts on again in
# Settings.
RSS_NEWS_VAPID_PRIVATE_KEY=
# Who push services can contact about our messages: a mailto: or https:// URL.
RSS_NEWS_VAPID_SUBJECT=https://rickphobia.com/ai-projects/rss-news/
